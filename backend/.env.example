# Configuration of the AFib Monitor server. Copy to backend/.env, fill in, then load it before starting uvicorn:
#   cd backend && cp .env.example .env && set -a && . ./.env && set +a && uvicorn app.main:app --port 8000
# Every variable is optional for a local run; the commented ones stay off until you uncomment and fill them.
# Never commit .env (it is in .gitignore); in production set them in Render → Environment. No value here is a secret.

# --- core ---------------------------------------------------------------------------------------------------------
# Database. Empty = SQLite file backend/afib.db. Production: the PostgreSQL URL from Neon (postgres:// is accepted).
# DATABASE_URL=
# Token signing secret, at least 32 characters. Empty = a random secret per run (everyone is logged out on restart).
# JWT_SECRET=
# 1 = create the demo doctor (doctor@demo.kg / demo1234, code DEMO42) and five demo patients. 0 for real patients.
SEED_DEMO=1
# 1 = demo patients keep sending readings every few seconds (default: same as SEED_DEMO).
DEMO_LIVE=0
# research = AF estimates and alerts for pilot participants (consent + doctor); wellness = never.
PRODUCT_MODE=research
# Local time zone of the patients, hours from UTC (Asia/Bishkek = 6).
TZ_OFFSET_HOURS=6
# Public address used in links (export, Telegram webhook). Render sets RENDER_EXTERNAL_URL by itself.
# PUBLIC_URL=

# --- owner tools ----------------------------------------------------------------------------------------------------
# Header X-Admin-Token for /api/admin/plan and /api/admin/status. Empty = admin routes always answer 403.
# ADMIN_TOKEN=

# --- Telegram (optional) --------------------------------------------------------------------------------------------
# Token from @BotFather. Empty = bot off. Locally the bot uses long polling; with PUBLIC_URL / RENDER_EXTERNAL_URL a webhook.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Chat that receives clinic invoice requests.
# TELEGRAM_ADMIN_CHAT=
# Alert only after this many seconds of sustained AF; wait this long for the onset ECG image; per-chat cooldown (minutes).
TELEGRAM_CONFIRM_S=30
TELEGRAM_ECG_WAIT_S=20
TELEGRAM_COOLDOWN_MIN=15

# --- store subscriptions (optional) ---------------------------------------------------------------------------------
# Shared secret that RevenueCat sends in the Authorization header of its webhook. Empty = webhook answers 403.
# REVENUECAT_WEBHOOK_SECRET=

# --- serving the portal -----------------------------------------------------------------------------------------------
# Folder with the built portal (npm run build in web/). Default: ../web/dist
# WEB_DIST=

# The phone app reads its own public keys at build time (not secrets): EXPO_PUBLIC_RC_IOS, EXPO_PUBLIC_RC_ANDROID.
